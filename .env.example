# Copy this file to .env and fill in your own values.
OPENAI_API_KEY=
DATA_PATH=data/raw
MODEL_NAME=baseline

# RosterWatch season settings (defaults shown)
ROSTERWATCH_SEASON=2026
ROSTERWATCH_HISTORY_START=2022

# Google Cloud, for BigQuery (see infra/README.md)
GCP_PROJECT_ID=your-gcp-project-id
BQ_DATASET=rosterwatch
BQ_LOCATION=US
# Only if using a service-account key file (keep it OUTSIDE the repo):
# GOOGLE_APPLICATION_CREDENTIALS=/Users/you/keys/rosterwatch-sa.json
