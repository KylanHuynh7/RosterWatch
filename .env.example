# Optional settings for the hosting scripts in infra/. A local run of the
# dashboard, the notebook or the backtests needs none of these.
# The scripts read them from your shell (export NAME=value); nothing loads
# .env automatically. Never commit a real .env file.

# Google Cloud project that holds the BigQuery dataset
# (infra/load_bigquery.sh defaults to rosterwatch-ds3-fall2026;
#  infra/fetch_data.py defaults to your gcloud project).
RW_BQ_PROJECT=

# BigQuery dataset with the weekly_usage and espn_ownership tables.
RW_BQ_DATASET=rosterwatch

# Folder infra/fetch_data.py writes the two tables to.
RW_OUT_DIR=data/processed
