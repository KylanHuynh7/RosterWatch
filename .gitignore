# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.venv/
venv/

# Jupyter
.ipynb_checkpoints/

# Environment and secrets
.env
.env.local
.env.*
!.env.example

# Data and generated artifacts
data/*
!data/README.md
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep
# Rostership snapshots are committed: ESPN only serves today's number, so past
# weeks can't be re-downloaded. Small CSVs (~40 KB/week).
!data/raw/rostership/
results/*
!results/.gitkeep
models/*
!models/.gitkeep

# OS/editor files
.DS_Store
.vscode/
.idea/

# Test and coverage outputs
.pytest_cache/
.coverage
htmlcov/
